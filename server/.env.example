# Copy to .env for local dev (NEVER commit .env)

# Google OAuth — get these from Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Where Google sends the user back after they grant consent.
# For local dev: http://localhost:5000/api/auth/callback
# For prod:      https://YOUR-APP.onrender.com/api/auth/callback
OAUTH_REDIRECT_URI=http://localhost:5000/api/auth/callback

# Random secret for Flask session cookie. Generate with: python -c 'import secrets; print(secrets.token_hex(32))'
FLASK_SECRET=replace-with-a-long-random-hex-string

# Optional. Defaults to sqlite:///kanban.db (file in server/).
# For Render, set this to your Neon Postgres URL.
# DATABASE_URL=postgresql://user:pass@host/dbname
